{
  "name": "paratrooper-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paratrooper chat PWA — message the pinboard agent from your phone.",
  "scripts": {
    "dev": "vite",
    "dev:playground": "vite playground",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground/tsconfig.json",
    "build": "npm run typecheck && vite build && vite build playground",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
