# Secrets are environment variables, NEVER the configuration source. Copy to
# .env (gitignored) for local dev, or set these as service env vars on Render.
#
# There are three kinds of value in this file and nowhere else:
#   1. the one configuration variable (below),
#   2. two machine paths, which name places on a disk,
#   3. secrets.

# --- The configuration: one variable, both services, both profiles -----------
# The whole deployment configuration — profile, model, notification texts,
# upload expiry and, on pinboard, the site's own settings — base64-encoded.
# Edit config/paratrooper.toml (gitignored; copy config/paratrooper.example.toml),
# then either:
#   python -m paratrooper.deploy push config/paratrooper.toml   # sets it on Render
#   base64 < config/paratrooper.toml | tr -d '\n'               # by hand
# There is no path variable, no bundled file and no fallback: a service either
# has this value or refuses to start.
PARATROOPER_CONFIG_B64=

# --- Machine paths ------------------------------------------------------------
# Where this container stages photos. Required on BOTH services. The web service
# derives its thread database as <parent>/threads.sqlite.
PARATROOPER_INBOX=./data/inbox
# The site checkout the pinboard worker edits, cloned on boot from
# [pinboard].remote. Required by the pinboard WORKER only; not set on the web
# service, and not used by any other profile.
PARATROOPER_SITE_ROOT=./site_checkout

# --- App auth (PWA <-> backend), web service ---------------------------------
# Shared bearer token. Generate: openssl rand -hex 32
PARATROOPER_APP_TOKEN=

# --- Agent auth (manual mode, no fallback), worker ---------------------------
AGENT_AUTH=subscription
# For AGENT_AUTH=subscription. Generate: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# For AGENT_AUTH=api only (subscription mode actively clears this).
# ANTHROPIC_API_KEY=

# --- GitHub, pinboard only ----------------------------------------------------
# The worker reaches GitHub only through its own push/pull-request tools, as the
# GitHub App named below: it signs a JWT with the App's private key and trades it
# for an installation token that lives an hour. The agent's shell holds no GitHub
# credential of any kind. Paste the .pem in full, BEGIN and END lines included,
# either across several lines or with the line breaks written as backslash-n.
# A plain deployment sets none of these three.
PARATROOPER_GITHUB_APP_ID=
PARATROOPER_GITHUB_APP_INSTALLATION_ID=
PARATROOPER_GITHUB_APP_KEY_PEM=
# The WEB service's own credential, used only to merge a pull request when
# Publish is tapped. Pinboard only.
PARATROOPER_MERGE_TOKEN=

# --- Spotify (optional, either profile: resolve a song by name) --------------
# Absent means no resolve_spotify tool at all, on any profile.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Web push (optional, web service) ----------------------------------------
# Absent means the whole feature is a no-op and the phone never subscribes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Queue ---------------------------------------------------------------------
# Key Value / Redis, shared by both services. On Render this is wired by the
# blueprint from the keyvalue service.
REDIS_URL=

# --- Worker wake/sleep (optional, Render only) -------------------------------
# Set BOTH on the WEB service and it will resume the worker when a job is
# enqueued and suspend it when the queue drains. Leave unset -> always-on.
# RENDER_API_KEY=            # Render dashboard -> Account Settings -> API Keys
# RENDER_WORKER_SERVICE_ID=  # the worker's srv-... id, from its dashboard URL
