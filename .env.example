# Secrets are environment variables, NEVER a config file. Copy to .env (gitignored)
# for local dev, or set these as service env vars on Render.

# --- App auth (PWA <-> backend) ---
# Shared bearer token. Generate: openssl rand -hex 32
PARATROOPER_APP_TOKEN=

# --- GitHub (worker pushes branches + opens PRs) ---
# Fine-grained PAT, scoped to the website repo, with Contents + Pull requests: write.
PARATROOPER_GITHUB_TOKEN=
# Optional: override the site repo remote (else auto-detected from the checkout's origin).
# PARATROOPER_REMOTE=https://github.com/AsteroidHunter/webpage.git

# --- Agent auth (manual mode, no fallback) ---
AGENT_AUTH=subscription
# For AGENT_AUTH=subscription. Generate: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# For AGENT_AUTH=api only (subscription mode actively clears this).
# ANTHROPIC_API_KEY=

# --- Spotify (optional: resolve a song by name; links need no auth) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Web push (Phase 6) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Worker wake/sleep (optional, Render only; saves ~$25/mo idle) ---
# Set BOTH on the WEB service and it will resume the worker when a job is
# enqueued and suspend it when the queue drains. Leave unset -> always-on.
# RENDER_API_KEY=          # Render dashboard -> Account Settings -> API Keys
# RENDER_WORKER_SERVICE_ID=  # the worker's srv-... id, from its dashboard URL

# --- Config file location (optional; defaults to config/paths.toml) ---
# PARATROOPER_CONFIG=config/paths.toml
