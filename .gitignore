# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / PWA
node_modules/
pwa/dist/
*.tsbuildinfo

# Secrets & local state (NEVER commit — secrets are env vars only)
.env
.env.*
!.env.example
*.local

# The real deployment configuration. Not a secret store — secrets are env vars —
# but it names one person's site, repository and commit identity, so only the
# placeholder example is committed. The pattern covers a second local source too
# (a plain one for local runs, for instance); the example stays tracked.
config/paratrooper.toml
config/paratrooper*.toml
!config/paratrooper.example.toml

# Runtime data (persistent disk on Render; local dev only)
data/
inbox/
*.sqlite
*.sqlite3
*.db

# Site checkout the worker operates on (cloned at runtime)
site_checkout/

# OS
.DS_Store
