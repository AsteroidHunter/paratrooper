# Worker service image (checklist 5.2): Agent SDK + git + Playwright/Chromium.
# Sized for Chromium (~1-2GB RAM at runtime). The Claude Agent SDK bundles its
# own native CLI, so no Node is needed here.

# python:3.12-slim as it stood on 2026-09-07 (Python 3.12.14, Debian 13
# trixie), the same interpreter the live worker reports. See PINNING.md.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
WORKDIR /app
ENV PYTHONUNBUFFERED=1

# git: the boot clone, the agent's local branch/commit work, and the worker's
# own fetch and push. ca-certificates: HTTPS to GitHub. curl: fetches the
# nodesource installer below (the agent's own curl cannot reach GitHub).
# node/npm: screenshot_board runs the site's `npm run build` (Astro) — the
# Claude SDK itself needs no Node (bundled native CLI), but the SITE build does.
# `gh` is deliberately NOT here any more (checklist 2.1). It was the sanctioned
# road to the GitHub API while the agent's shell held a token; the shell holds
# none now, pushing and pull requests are worker-owned tools, and a GitHub
# client sitting on the PATH with nothing to authenticate with is just one more
# thing for a prompt injection to reach for.
# bubblewrap: the CLI's subprocess env scrub (CLAUDE_CODE_SUBPROCESS_ENV_SCRUB,
# set for every session) is implemented on Linux by running each agent shell
# under `bwrap`, and the CLI refuses to start at all when it cannot find it —
# every message dies with "bubblewrap is required for subprocess env scrubbing".
# The macOS CLI needs no such binary, which is why only the Linux image cares.
# Debian's build is not setuid: it relies on unprivileged user namespaces, which
# the platform permits, so it works as the non-root user below. socat is NOT
# needed with it: the CLI only spawns socat to bridge a restricted network, and
# the scrub leaves the network alone.
# Node stays on major 22, which is what the running worker reports (v22.23.2).
# The major is pinned; the rest is not, and honestly so: `setup_22.x` is fetched
# from nodesource at build time and installs whatever 22.x their apt suite holds
# that day, so the patch level can move under a rebuild. Pinning it the rest of
# the way means dropping the script and installing a named nodejs version from
# a keyring and apt source written into the image by hand. That is a change of
# install route, so it is a deliberate follow-up, not part of this pass.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl bubblewrap \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# The license file rides with it: the package metadata names the license by
# file rather than by code, since the license has no short code of the kind
# SPDX publishes, so the build cannot produce metadata without it.
COPY pyproject.toml LICENSE.md constraints-agent.txt ./
COPY src ./src
COPY config ./config
# The ranges in pyproject.toml say what the code needs; constraints-agent.txt
# says which version of each the running worker actually holds, transitive
# packages included. The SDK's own pin stays in pyproject.toml, where the
# reason for it is written down.
RUN pip install --no-cache-dir -c constraints-agent.txt -e ".[agent]"

# Chromium + its OS dependencies for screenshot_board. It runs with its own
# sandbox on: a probe on the running worker found unprivileged user namespaces
# permitted here, so the browser needs no --no-sandbox and its renderers are
# genuinely confined. That sandbox is Chromium's own and has nothing to do with
# the bubblewrap above, which only wraps the agent's shell commands; the browser
# is launched from the worker's own process, outside it.
# The browsers land in a shared path rather than root's cache, so the
# unprivileged runtime user below can actually read them.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN python -m playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright

# Nothing the worker does needs root. It owns exactly what it writes: its home
# (the Claude CLI's ~/.claude settings, npm's cache), the site checkout it
# clones into (the changelog and board screenshot live inside it), and the
# inbox it materializes photos into.
# The empty ~/.ssh is Render's price of admission: its SSH closes the session
# the instant it logs in unless the running user already owns one at 0700, and
# the sandbox probe rides in over exactly that shell.
# The folder alone is not enough, which cost a login on the platform to find
# out: `useradd` leaves the new account marked locked, and Render refuses SSH
# into a container whose running account is locked, so the session closes the
# moment it opens. `usermod -p '*'` clears the lock and leaves a password field
# that matches no password, so only a key Render itself holds gets in. Do not
# reach for `passwd -u` instead: it refuses to unlock a passwordless account and
# fails the image build outright.
ENV HOME=/home/app
RUN useradd --create-home --home-dir /home/app --uid 1000 --shell /bin/bash app \
    && usermod -p '*' app \
    && mkdir -p /home/app/.claude /home/app/.ssh /app/site_checkout /tmp/paratrooper-inbox \
    && chown -R app:app /home/app /app/site_checkout /tmp/paratrooper-inbox \
    && chmod 0700 /home/app/.ssh
# The start-up wrapper, not the worker, is the process this image runs first.
# It writes the worker-only secrets to a private file, drops them from its own
# environment and execs the worker, so the worker's /proc/1/environ — which the
# agent runs as the same user and could read — never held them.
COPY docker/worker-entrypoint.sh /usr/local/bin/worker-entrypoint
RUN chmod 0755 /usr/local/bin/worker-entrypoint

USER app

# hands the secrets over, then clones the site repo on first boot and consumes
# jobs from the queue
ENTRYPOINT ["worker-entrypoint"]
