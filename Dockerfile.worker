# Worker service image (checklist 5.2): Agent SDK + git + Playwright/Chromium.
# Sized for Chromium (~1-2GB RAM at runtime). The Claude Agent SDK bundles its
# own native CLI, so no Node is needed here.

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1

# git: site-repo clone + branch/commit/push. ca-certificates: HTTPS to GitHub.
# node/npm: screenshot_board runs the site's `npm run build` (Astro) — the
# Claude SDK itself needs no Node (bundled native CLI), but the SITE build does.
# gh: the ONLY sanctioned road to the GitHub API. The prompt tells the agent to
# open and inspect PRs with `gh pr create`/`gh pr list`, and the PreToolUse guard
# refuses every other route (curl/python/node to github.com, `gh api`), so the
# binary has to actually be here — without it the agent falls back to raw REST.
# Installed from GitHub's own apt repository (keyring + signed-by source line).
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && install -m 0755 -d /etc/apt/keyrings /etc/apt/sources.list.d \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs gh \
    && rm -rf /var/lib/apt/lists/*

# The license file rides with it: the package metadata names the license by
# file rather than by code, since the license has no short code of the kind
# SPDX publishes, so the build cannot produce metadata without it.
COPY pyproject.toml LICENSE.md ./
COPY src ./src
COPY config ./config
RUN pip install --no-cache-dir -e ".[agent]"

# Chromium + its OS dependencies for screenshot_board (run with --no-sandbox).
# The browsers land in a shared path rather than root's cache, so the
# unprivileged runtime user below can actually read them.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN python -m playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright

# Nothing the worker does needs root. It owns exactly what it writes: its home
# (the Claude CLI's ~/.claude settings, npm's cache), the site checkout it
# clones into (the changelog and board screenshot live inside it), and the
# inbox it materializes photos into.
# The empty ~/.ssh is Render's price of admission: its SSH closes the session
# the instant it logs in unless the running user already owns one at 0700, and
# the sandbox probe rides in over exactly that shell. useradd leaves the
# account locked, which Render's SSH also refuses, so unlock it; no password is
# set either way, and nothing can log in without a key Render itself holds.
ENV HOME=/home/app
RUN useradd --create-home --home-dir /home/app --uid 1000 --shell /bin/bash app \
    && mkdir -p /home/app/.claude /home/app/.ssh /app/site_checkout /tmp/paratrooper-inbox \
    && chown -R app:app /home/app /app/site_checkout /tmp/paratrooper-inbox \
    && chmod 0700 /home/app/.ssh \
    && passwd -u app
USER app

# clones the site repo on first boot, then consumes jobs from the queue
CMD ["python", "-m", "paratrooper.web.worker_runner"]
