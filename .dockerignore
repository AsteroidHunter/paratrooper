# keep build contexts small + avoid shipping local state/artifacts into images
.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.git/
node_modules/
pwa/node_modules/
pwa/dist/
data/
inbox/
site_checkout/
*.sqlite
*.sqlite3
.env
.env.*
# the real configuration never enters an image: the services read it out of
# PARATROOPER_CONFIG_B64 at run time and from nowhere else. The pattern also
# covers a local plain source sitting beside it.
config/paratrooper.toml
config/paratrooper*.toml
!config/paratrooper.example.toml
*.local
**/*.local
.DS_Store
