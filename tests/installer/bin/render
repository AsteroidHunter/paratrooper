#!/usr/bin/env bash
# Mock Render CLI for offline verification of install.sh.
# Records what it was asked to do under $MOCK_STATE_DIR and never echoes a secret
# value to stdout/stderr (so it cannot leak one into the installer's log), while
# stashing the values it received in a private file for the test to assert on.
set -u

STATE="${MOCK_STATE_DIR:?MOCK_STATE_DIR must be set}"
CALLS="$STATE/render.calls"
ENVSET="$STATE/env_set.txt"
mkdir -p "$STATE"

sub="${1:-}"
sub2="${2:-}"

case "$sub" in
  login)
    printf 'render login\n' >>"$CALLS"
    if [ "${MOCK_RENDER_LOGIN_WAIT:-0}" = "1" ]; then
      echo "mock render login waiting" >&2
      printf '%s\n' "$$" >"$STATE/render_login_wait.pid"
      exec sleep 120
    fi
    [ "${MOCK_RENDER_LOGIN_FAIL:-0}" = "1" ] && { echo "login failed" >&2; exit 1; }
    if [ "${MOCK_WORKSPACE_FRESH:-0}" = "1" ]; then
      mkdir -p "$HOME/.render"
      [ -f "$HOME/.render/cli.yaml" ] ||
        printf 'version: 1\napi:\n  key: mock-cli-token\n' > "$HOME/.render/cli.yaml"
    fi
    echo "Opened browser to authenticate. Signed in."
    exit 0
    ;;
  workspace)
    printf 'render workspace %s\n' "$sub2" >>"$CALLS"
    [ "${MOCK_WORKSPACE_FAIL:-0}" = "1" ] && { echo "no workspace" >&2; exit 1; }
    case "$sub2" in
      current)
        [ "${MOCK_WORKSPACE_CURRENT_ERROR:-0}" = "1" ] && { echo "request failed" >&2; exit 1; }
        if [ "${MOCK_WORKSPACE_FRESH:-0}" = "1" ]; then
          workspace_id="${RENDER_WORKSPACE:-}"
          workspace_name="Selected Workspace"
          if [ -z "$workspace_id" ] && [ -f "$HOME/.render/cli.yaml" ]; then
            while IFS= read -r line; do
              case "$line" in
                'workspace: '*) workspace_id="${line#workspace: }" ;;
                'workspace_name: '*) workspace_name="${line#workspace_name: }" ;;
              esac
            done < "$HOME/.render/cli.yaml"
          fi
          [ -n "$workspace_id" ] || { echo 'no workspace set. Use `render workspace set` to set a workspace' >&2; exit 1; }
        else
          workspace_id="${RENDER_WORKSPACE:-tea-test000000000000000}"
          workspace_name="Test Workspace"
        fi
        if [ "${3:-}" = "--output" ] && [ "${4:-}" = "json" ]; then
          printf '{"id":"%s","name":"%s"}\n' "$workspace_id" "$workspace_name"
        else
          printf '%s (%s)\n' "$workspace_id" "$workspace_name"
        fi
        exit 0
        ;;
      set)
        if [ "${MOCK_WORKSPACE_FRESH:-0}" = "1" ]; then
          case "${MOCK_WORKSPACE_SET:-interactive}" in
            cancel) echo "Selection canceled."; exit 0 ;;
            empty) echo "No workspaces are available." >&2; exit 1 ;;
            error) echo "Could not list workspaces." >&2; exit 1 ;;
            interactive)
              printf 'Select a workspace (1 or 2): '
              IFS= read -r choice || exit 1
              case "$choice" in
                1) workspace_id="tea-first000000000000001" ;;
                2) workspace_id="tea-second00000000000002" ;;
                *) echo "Selection canceled."; exit 0 ;;
              esac
              printf 'workspace: %s\nworkspace_name: Selected Workspace\n' "$workspace_id" >> "$HOME/.render/cli.yaml"
              printf 'Workspace set to: Selected Workspace (%s)\n' "$workspace_id"
              exit 0
              ;;
          esac
        fi
        echo "tea-test000000000000000 (Test Workspace)"
        exit 0
        ;;
    esac
    echo "mock render: unhandled workspace command '$sub2'" >&2
    exit 2
    ;;
  blueprints)
    printf 'render blueprints %s\n' "$sub2" >>"$CALLS"
    if [ "${MOCK_BP_WAIT:-0}" = "1" ]; then
      echo "mock blueprint validation waiting" >&2
      printf '%s\n' "$$" >"$STATE/blueprint_wait.pid"
      [ "${MOCK_BP_IGNORE_TERM:-0}" != "1" ] || trap '' TERM
      exec sleep 120
    fi
    if [ "${MOCK_BP_CLOUDFLARE:-0}" = "1" ]; then
      echo 'validation request failed with status 403: <!DOCTYPE html><html><head><title>Attention Required! | Cloudflare</title></head><body><h1>Sorry, you have been blocked</h1><p>Cloudflare Ray ID: fake-test-ray</p></body></html>' >&2
      exit 1
    fi
    if [ "${MOCK_BP_FORBIDDEN:-0}" = "1" ]; then
      echo 'validation request failed with status 403: {"message":"workspace permission denied"}' >&2
      exit 1
    fi
    [ "${MOCK_BP_FAIL:-0}" = "1" ] && { echo "blueprint invalid" >&2; exit 1; }
    echo "render.yaml is valid."
    exit 0
    ;;
  services)
    if [ "$sub2" = "update" ]; then
      printf 'render services update %s\n' "${3:-}" >>"$CALLS"
      [ "${MOCK_UPDATE_FAIL:-0}" = "1" ] && { echo "update failed" >&2; exit 1; }
      # Record each KEY=VALUE for the test, but print only a benign line.
      shift 3
      while [ "$#" -gt 0 ]; do
        if [ "$1" = "--env-var" ] && [ "$#" -ge 2 ]; then
          printf '%s\n' "$2" >>"$ENVSET"
          shift 2
        else
          shift
        fi
      done
      echo "Updated service; a new deploy was triggered."
      exit 0
    fi
    # Listing. The installer passes --output json.
    printf 'render services --output json\n' >>"$CALLS"
    [ "${MOCK_SERVICES_FAIL:-0}" = "1" ] && { echo "list failed" >&2; exit 1; }
    if [ -n "${MOCK_SERVICES_JSON:-}" ]; then
      cat "$MOCK_SERVICES_JSON"
    else
      cat <<'JSON'
[
  {"service": {"id": "srv-web0000000000000000", "name": "paratrooper-web",
    "type": "web_service", "serviceDetails": {"url": "https://paratrooper-web.onrender.com"}}},
  {"service": {"id": "srv-wrk0000000000000000", "name": "paratrooper-worker",
    "type": "background_worker"}},
  {"service": {"id": "srv-kv00000000000000000", "name": "paratrooper-kv",
    "type": "key_value"}}
]
JSON
    fi
    exit 0
    ;;
  deploys)
    printf 'render deploys %s\n' "$sub2" >>"$CALLS"
    echo "deploy triggered"
    exit 0
    ;;
  *)
    printf 'render %s\n' "$*" >>"$CALLS"
    echo "mock render: unhandled subcommand '$sub'" >&2
    exit 2
    ;;
esac
