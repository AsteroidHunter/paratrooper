# Web service image: build the TypeScript PWA, then run the FastAPI app that
# serves it and holds the socket. Multi-stage so the Render build env needs no
# Node toolchain of its own.

# --- stage 1: build the PWA -> /pwa/dist ---
# node:22-slim as it stood on 2026-09-07 (Node 22.23.2). The tag moves; the
# digest does not, so a bump is a deliberate edit here rather than whatever the
# tag pointed at the morning of a rebuild. See PINNING.md.
FROM node:22-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS pwa
# Render passes the service's env vars (incl. its default RENDER_GIT_COMMIT) to
# docker build as build args; the bundle bakes it in as __SERVER_VERSION__ so a
# stale cached client can detect a redeployed server and self-refresh.
ARG RENDER_GIT_COMMIT=dev
ENV RENDER_GIT_COMMIT=$RENDER_GIT_COMMIT
WORKDIR /pwa
COPY pwa/package.json pwa/package-lock.json ./
RUN npm ci
COPY pwa/ ./
RUN npm run build

# --- stage 2: python web service ---
# python:3.12-slim as it stood on 2026-09-22 (built 2026-09-19: Python 3.12.14,
# Debian 13 trixie with its glibc, SQLite, PCRE2 and tzdata updates), the same
# interpreter the live service reports. See PINNING.md.
FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
WORKDIR /app
ENV PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# The license file rides with it: the package metadata names the license by
# file rather than by code, since the license has no short code of the kind
# SPDX publishes, so the build cannot produce metadata without it.
COPY pyproject.toml LICENSE.md constraints-web.txt ./
COPY src ./src
# No config folder ships in the image. The whole configuration arrives at run
# time in PARATROOPER_CONFIG_B64, base64-encoded, and a copy baked in here would
# be a second source able to disagree with it.
# The ranges in pyproject.toml say what the code needs; constraints-web.txt
# says which version of each the running service actually holds, transitive
# packages included. Without it every rebuild re-resolved the ranges against
# whatever was newest that day.
RUN pip install --no-cache-dir -c constraints-web.txt -e ".[web]"
# the built PWA, served at / by app.py (_pwa_dist resolves /app/pwa/dist)
COPY --from=pwa /pwa/dist ./pwa/dist
# uvicorn factory; Render injects $PORT
CMD ["sh", "-c", "uvicorn 'paratrooper.web.app:create_app' --factory --host 0.0.0.0 --port ${PORT:-8000}"]
